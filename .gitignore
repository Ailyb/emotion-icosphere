# Python
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.coverage

# Virtual environments
.venv/
venv/
env/
ENV/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Environment
.env
.env.local

# Logs
*.log
backend.log

# Data (large files - consider git-lfs if needed)
data/hidden_states/*.json
data/emotion_vectors/*.json
data/emotion_vectors/*.png

# Model cache (downloaded automatically)
~/.cache/huggingface/
# claude_tests large data files (exceed GitHub 100MB limit)
claude_tests/data/**/*.npz
claude_tests/data/**/*.png
graphify-out/
# Test-only / private data: never commit (see claude_tests/CLAUDE.md)
claude_tests/data/hardset/
claude_tests/data/**/errors_*.md

# Third-party raw datasets (re-downloadable; see manifests)
claude_tests/data/external/

# External test sets (third-party text; terms unclear or share-alike): commit manifests only, rebuild with probekit_external.py
claude_tests/data/testsets/dair_test_frozen.jsonl
claude_tests/data/testsets/isear_test_frozen.jsonl
claude_tests/data/testsets/dailydialog_test_frozen.jsonl

# Calibration texts (GoEmotions comments, rebuildable from the ids and manifest)
claude_tests/data/testsets/goemotions_calibration.jsonl

# Steering outputs: generated text and judge labels stay local; commit aggregates only
claude_tests/data/steering/*.jsonl
claude_tests/data/steering/*.npz

# files containing GoEmotions (Reddit) text: rebuilt locally by claude_tests/rebuild_human_data.sh, only ids/hashes are kept in git
claude_tests/data/testsets/goemotions_test_frozen.jsonl
claude_tests/data/corpus/corpus_human_goemotions*.jsonl
claude_tests/data/corpus/corpus_merged.jsonl
claude_tests/data/corpus/corpus_merged_scored.jsonl
claude_tests/data/corpus/corpus_merged2.jsonl
claude_tests/data/corpus/corpus_merged2_scored.jsonl
claude_tests/data/steering_gemma/*.jsonl
claude_tests/data/steering_gemma/*.npz
claude_tests/data/steering_gemma/*.log
